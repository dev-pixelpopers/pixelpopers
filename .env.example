# Copy to .env.local (local) or set in Vercel → Settings → Environment Variables.

# The Laravel CMS (backend/). Every page reads its content from here; leave it
# empty — or if the CMS is unreachable — and the site shows its built-in content.
CMS_API_URL=http://127.0.0.1:8000

# Shared with the CMS (Site settings → Frontend): lets the CMS refresh the
# site's cached pages right after a save, via POST /api/revalidate.
REVALIDATE_SECRET=change-me-to-a-long-random-string
